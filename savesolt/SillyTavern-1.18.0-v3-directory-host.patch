+import { clientRelativePath, isPathUnderParent } from '../util.js';
 
 export const router = express.Router();
 
+export function validateFileDirectory(input) {
+    if (input === undefined || input === null || input === '') {
+        return { error: false, directory: '' };
+    }
+
+    if (typeof input !== 'string' || input.length > 256 || input.includes('\\')) {
+        return { error: true, message: 'Invalid upload directory.' };
+    }
+
+    const segments = input.split('/');
+    if (segments.some(segment => !segment || segment === '.' || segment === '..')) {
+        return { error: true, message: 'Invalid upload directory.' };
+    }
+
+    for (const segment of segments) {
+        if (!/^[a-zA-Z0-9_-]+$/.test(segment) || sanitize(segment) !== segment) {
+            return { error: true, message: 'Invalid upload directory.' };
+        }
+    }
+
+    return { error: false, directory: segments.join(path.sep) };
+}
+
+function ensureUploadDirectory(filesDirectory, relativeDirectory) {
+    // Security checks resolve symlinks via realpath, but the returned path is
+    // built from the caller's original (possibly relative) filesDirectory style
+    // so it stays comparable with request.user.directories.root in
+    // clientRelativePath, which does a plain startsWith string check.
+    const filesRoot = fs.realpathSync(filesDirectory);
+    let current = filesDirectory;
+    for (const segment of relativeDirectory.split(path.sep).filter(Boolean)) {
+        const next = path.join(current, segment);
+        if (fs.existsSync(next)) {
+            const stat = fs.lstatSync(next);
+            if (stat.isSymbolicLink() || !stat.isDirectory()) {
+                throw new Error('Invalid upload directory.');
+            }
+        } else {
+            fs.mkdirSync(next);
+        }
+        if (!isPathUnderParent(filesRoot, fs.realpathSync(next))) {
+            throw new Error('Invalid upload directory.');
+        }
+        current = next;
+    }
+    return current;
+}
