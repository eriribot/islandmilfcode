+    if (requestedDirectory === undefined || requestedDirectory === null || requestedDirectory === '') {
+        return { path: filesRoot };
+    }
+
+    if (typeof requestedDirectory !== 'string') {
+        return { error: 'Invalid upload directory' };
+    }
+
+    const directory = requestedDirectory.trim();
