+/**
+ * Checks whether a resolved path is contained by a directory.
+ * @param {string} directory Root directory
+ * @param {string} target Candidate path
+ * @param {boolean} allowSame Whether the candidate may equal the root
+ * @returns {boolean}
+ */
+function isPathInsideDirectory(directory, target, allowSame = false) {
