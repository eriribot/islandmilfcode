+        return { error: 'Invalid upload directory' };
+    }
+
+    const uploadDirectory = path.resolve(filesRoot, directory);
+    if (!isPathInsideDirectory(filesRoot, uploadDirectory)) {
+        return { error: 'Invalid upload directory' };
+    }
+
+    return { path: uploadDirectory };
+}
